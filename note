import sqlite3
import tkinter as tk
from tkinter import ttk, messagebox
import pandas as pd
from datetime import datetime


# إعداد قاعدة البيانات
def setup_database():
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    
    cursor.execute('''CREATE TABLE IF NOT EXISTS items (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        name TEXT NOT NULL UNIQUE,
                        quantity INTEGER
                    )''')
    
    cursor.execute('''CREATE TABLE IF NOT EXISTS transactions (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        item_name TEXT NOT NULL,
                        used_quantity INTEGER,
                        receiver TEXT,
                        transaction_date TEXT
                    )''')
    
    conn.commit()
    conn.close()

# التحقق من هيكل قاعدة البيانات وإصلاحها إذا لزم الأمر
def check_and_fix_database():
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    
    try:
        cursor.execute("SELECT quantity FROM items LIMIT 1")
    except sqlite3.OperationalError:
        try:
            cursor.execute("ALTER TABLE items RENAME COLUMN added_quantity TO quantity")
        except sqlite3.OperationalError:
            pass
        try:
            cursor.execute("ALTER TABLE items DROP COLUMN available_quantity")
        except sqlite3.OperationalError:
            pass
    
    try:
        cursor.execute("SELECT transaction_date FROM transactions LIMIT 1")
    except sqlite3.OperationalError:
        try:
            cursor.execute("ALTER TABLE transactions ADD COLUMN transaction_date TEXT")
        except sqlite3.OperationalError:
            pass
    
    conn.commit()
    conn.close()

# إضافة أو تحديث صنف
def add_item(name, quantity):
    if not name:
        messagebox.showerror("خطأ", "يرجى إدخال اسم الصنف!")
        return
    
    try:
        quantity = int(quantity or 0)
        if quantity < 0:
            messagebox.showerror("خطأ", "عدد الصنف يجب أن يكون رقمًا غير سالب!")
            return
    except ValueError:
        messagebox.showerror("خطأ", "يرجى إدخال رقم صحيح لعدد الصنف!")
        return
    
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    
    cursor.execute("SELECT quantity FROM items WHERE name = ?", (name,))
    result = cursor.fetchone()
    
    if result:
        messagebox.showinfo("تنبيه", f"الصنف '{name}' موجود بالفعل، سيتم تحديث عدد الصنف.")
        current_quantity = result[0]
        new_quantity = current_quantity + quantity
        cursor.execute("UPDATE items SET quantity = ? WHERE name = ?", (new_quantity, name))
    else:
        cursor.execute("INSERT INTO items (name, quantity) VALUES (?, ?)", (name, quantity))
    
    conn.commit()
    conn.close()
    refresh_inventory()
    update_item_dropdown()
    update_statistics()
    clear_item_entries()

# تعديل صنف
def edit_item():
    selected_item = tree_inventory.selection()
    if not selected_item:
        messagebox.showerror("خطأ", "يرجى اختيار صنف من الجدول لتعديله!")
        return
    
    item_values = tree_inventory.item(selected_item, "values")
    item_name = item_values[2]
    
    edit_window = tk.Toplevel(root)
    edit_window.title("تعديل صنف")
    edit_window.geometry("350x200")
    edit_window.configure(bg="#F5F5F5")
    
    tk.Label(edit_window, text=f"تعديل الصنف: {item_name}", bg="#F5F5F5", font=("Arial", 20, "bold"), fg="#000000").pack(pady=15)
    
    tk.Label(edit_window, text="عدد الصنف", bg="#F5F5F5", font=("Arial", 16), fg="#000000").pack()
    entry_edit_quantity = tk.Entry(edit_window, font=("Arial", 16), bg="#FFFFFF", fg="#000000", relief="flat", bd=1, highlightthickness=1, highlightbackground="#D4A017")
    entry_edit_quantity.insert(0, item_values[1])
    entry_edit_quantity.pack(pady=10, fill="x", padx=30)
    
    def save_changes():
        try:
            new_quantity = int(entry_edit_quantity.get() or 0)
            if new_quantity < 0:
                messagebox.showerror("خطأ", "عدد الصنف يجب أن يكون رقمًا غير سالب!")
                return
        except ValueError:
            messagebox.showerror("خطأ", "يرجى إدخال رقم صحيح لعدد الصنف!")
            return
        
        conn = sqlite3.connect("inventory.db")
        cursor = conn.cursor()
        cursor.execute("UPDATE items SET quantity = ? WHERE name = ?", (new_quantity, item_name))
        conn.commit()
        conn.close()
        refresh_inventory()
        update_statistics()
        edit_window.destroy()
        messagebox.showinfo("نجاح", "تم تعديل الصنف بنجاح!")
    
    tk.Button(edit_window, text="حفظ التغييرات", bg="#D4A017", fg="white", font=("Arial", 16, "bold"), command=save_changes, relief="flat", bd=0).pack(pady=15)

# حذف صنف
def delete_item():
    selected_item = tree_inventory.selection()
    if not selected_item:
        messagebox.showerror("خطأ", "يرجى اختيار صنف من الجدول لحذفه!")
        return
    
    item_values = tree_inventory.item(selected_item, "values")
    item_name = item_values[2]
    
    if messagebox.askyesno("تأكيد", f"هل أنت متأكد من حذف الصنف '{item_name}' وجميع العمليات المرتبطة به؟"):
        conn = sqlite3.connect("inventory.db")
        cursor = conn.cursor()
        cursor.execute("DELETE FROM items WHERE name = ?", (item_name,))
        cursor.execute("DELETE FROM transactions WHERE item_name = ?", (item_name,))
        conn.commit()
        conn.close()
        refresh_inventory()
        refresh_transactions()
        update_item_dropdown()
        update_statistics()
        messagebox.showinfo("نجاح", "تم حذف الصنف بنجاح!")

# إضافة عملية استخدام
def add_transaction(item_name, used_quantity, receiver):
    if not item_name or not used_quantity or not receiver:
        messagebox.showerror("خطأ", "يرجى إدخال جميع الحقول!")
        return
    
    try:
        used_quantity = int(used_quantity)
        if used_quantity <= 0:
            messagebox.showerror("خطأ", "الكمية المستخدمة يجب أن تكون أكبر من صفر!")
            return
    except ValueError:
        messagebox.showerror("خطأ", "يرجى إدخال رقم صحيح للكمية المستخدمة!")
        return
    
    used, final_balance = get_item_details(item_name)
    if final_balance < used_quantity:
        messagebox.showerror("خطأ", f"الكمية المستخدمة ({used_quantity}) أكبر من الرصيد النهائي ({final_balance})!")
        return
    
    transaction_date = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    cursor.execute("INSERT INTO transactions (item_name, used_quantity, receiver, transaction_date) VALUES (?, ?, ?, ?)",
                   (item_name, used_quantity, receiver, transaction_date))
    conn.commit()
    conn.close()
    refresh_inventory()
    refresh_transactions()
    update_statistics()
    clear_transaction_entries()

# حساب الكمية المستخدمة والرصيد النهائي
def get_item_details(item_name):
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()  # تصحيح الخطأ: استخدام conn بدلاً من Conn
    
    cursor.execute("SELECT quantity FROM items WHERE name = ?", (item_name,))
    result = cursor.fetchone()
    if not result:
        return 0, 0
    
    quantity = result[0]
    
    cursor.execute("SELECT SUM(used_quantity) FROM transactions WHERE item_name = ?", (item_name,))
    used = cursor.fetchone()[0] or 0
    
    final_balance = quantity - used
    
    conn.close()
    return used, final_balance

# تحديث جدول المخزن
def refresh_inventory(search_query=""):
    for row in tree_inventory.get_children():
        tree_inventory.delete(row)
    
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    if search_query:
        cursor.execute("SELECT name FROM items WHERE name LIKE ?", ('%' + search_query + '%',))
    else:
        cursor.execute("SELECT name FROM items")
    items = cursor.fetchall()
    
    for i, item in enumerate(items):
        item_name = item[0]
        used, final_balance = get_item_details(item_name)
        cursor.execute("SELECT quantity FROM items WHERE name = ?", (item_name,))
        quantity = cursor.fetchone()[0]
        tag = "evenrow" if i % 2 == 0 else "oddrow"
        tree_inventory.insert("", "end", values=(final_balance, quantity, item_name), tags=(tag,))
    
    conn.close()

# تحديث جدول العمليات
def refresh_transactions(filter_receiver=""):
    for row in tree_transactions.get_children():
        tree_transactions.delete(row)
    
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    if filter_receiver:
        cursor.execute("SELECT item_name, used_quantity, receiver, transaction_date FROM transactions WHERE receiver LIKE ?",
                       ('%' + filter_receiver + '%',))
    else:
        cursor.execute("SELECT item_name, used_quantity, receiver, transaction_date FROM transactions")
    transactions = cursor.fetchall()
    
    for i, trans in enumerate(transactions):
        tag = "evenrow" if i % 2 == 0 else "oddrow"
        tree_transactions.insert("", "end", values=trans, tags=(tag,))
    
    conn.close()

# تحديث الإحصائيات
def update_statistics():
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    
    cursor.execute("SELECT COUNT(*) FROM items")
    total_items = cursor.fetchone()[0]
    
    cursor.execute("SELECT SUM(quantity) FROM items")
    total_quantity = cursor.fetchone()[0] or 0
    
    cursor.execute("SELECT SUM(used_quantity) FROM transactions")
    total_used = cursor.fetchone()[0] or 0
    
    conn.close()
    
    stats_label.config(text=f"إجمالي الأصناف: {total_items} | "
                           f"إجمالي عدد الأصناف: {total_quantity} | "
                           f"إجمالي الكمية المستخدمة: {total_used}")

# تصدير بيانات المخزن إلى Excel
def export_to_excel():
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    
    cursor.execute("SELECT name, quantity FROM items")
    items = cursor.fetchall()
    
    merged_data = []
    for item in items:
        item_name, quantity = item
        used, final_balance = get_item_details(item_name)
        merged_data.append([final_balance, quantity, item_name])
    
    df = pd.DataFrame(merged_data, columns=["الرصيد النهائي", "عدد الصنف", "اسم الصنف"])
    df.to_excel("inventory_report.xlsx", sheet_name="تقرير المخزن", index=False)
    
    messagebox.showinfo("نجاح", "تم تصدير التقرير إلى inventory_report.xlsx")
    conn.close()

# مسح جميع البيانات
def clear_all_data():
    if messagebox.askyesno("تأكيد", "هل أنت متأكد من مسح جميع البيانات؟"):
        conn = sqlite3.connect("inventory.db")
        cursor = conn.cursor()
        cursor.execute("DELETE FROM items")
        cursor.execute("DELETE FROM transactions")
        conn.commit()
        conn.close()
        refresh_inventory()
        refresh_transactions()
        update_item_dropdown()
        update_statistics()
        messagebox.showinfo("نجاح", "تم مسح جميع البيانات!")

# تحديث القائمة المنسدلة لأسماء الأصناف
def update_item_dropdown():
    conn = sqlite3.connect("inventory.db")
    cursor = conn.cursor()
    cursor.execute("SELECT name FROM items")
    items = cursor.fetchall()
    item_names = [item[0] for item in items]
    conn.close()
    
    trans_item_dropdown['values'] = item_names
    if item_names:
        trans_item_dropdown.set(item_names[0])
    else:
        trans_item_dropdown.set("")

# تنظيف حقول إدخال الصنف
def clear_item_entries():
    entry_item_name.delete(0, tk.END)
    entry_quantity.delete(0, tk.END)

# تنظيف حقول إدخال العملية
def clear_transaction_entries():
    trans_item_dropdown.set("")
    entry_used.delete(0, tk.END)
    entry_receiver.delete(0, tk.END)

# البحث عن صنف
def search_item():
    search_query = entry_search.get()
    refresh_inventory(search_query)

# تصفية العمليات بناءً على اسم المستلم
def filter_transactions():
    filter_query = entry_filter_receiver.get()
    refresh_transactions(filter_query)

# تحديث الجداول
def refresh_all():
    refresh_inventory()
    refresh_transactions()
    update_item_dropdown()
    update_statistics()
    messagebox.showinfo("نجاح", "تم تحديث جميع البيانات!")

# تأكيد الإغلاق مع تصدير البيانات
def on_closing():
    if messagebox.askyesno("تأكيد الإغلاق", "هل تريد تصدير البيانات إلى Excel قبل الإغلاق؟"):
        export_to_excel()
    root.destroy()

# دالة لتحديث عرض الـ Canvas عند تغيير حجم النافذة
def update_canvas_width(event):
    canvas.itemconfig(canvas_window, width=event.width)

