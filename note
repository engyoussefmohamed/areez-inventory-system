entry_quantity = tk.Entry(frame_add_item, font=("Arial", 22), bg="#FFFFFF", fg="#000000", relief="flat", bd=1, highlightthickness=1, highlightbackground="#D4A017")
entry_quantity.grid(row=0, column=3, padx=15, pady=10, sticky="ew")

add_item_button = ttk.Button(frame_add_item, text="إضافة ➕", style="TButton", command=lambda: add_item(
    entry_item_name.get(), entry_quantity.get()
))
add_item_button.grid(row=0, column=4, padx=15, pady=10)

frame_add_item.grid_columnconfigure(1, weight=1)
frame_add_item.grid_columnconfigure(3, weight=1)

# إطار إدخال عملية استخدام
frame_add_transaction = tk.LabelFrame(scrollable_frame, text="📋 إضافة عملية استخدام", bg="#F5F5F5", fg="#000000", font=("Arial", 24, "bold"), relief="flat", bd=2, highlightthickness=1, highlightbackground="#D4A017")
frame_add_transaction.pack(fill="both", expand=True, padx=10, pady=3)

tk.Label(frame_add_transaction, text="اسم الصنف", bg="#F5F5F5", font=("Arial", 22), fg="#000000").grid(row=0, column=0, padx=15, pady=10, sticky="w")
trans_item_dropdown = ttk.Combobox(frame_add_transaction, font=("Arial", 22))
trans_item_dropdown.grid(row=0, column=1, padx=15, pady=10, sticky="ew")

tk.Label(frame_add_transaction, text="الكمية المستخدمة", bg="#F5F5F5", font=("Arial", 22), fg="#000000").grid(row=0, column=2, padx=15, pady=10, sticky="w")
entry_used = tk.Entry(frame_add_transaction, font=("Arial", 22), bg="#FFFFFF", fg="#000000", relief="flat", bd=1, highlightthickness=1, highlightbackground="#D4A017")
entry_used.grid(row=0, column=3, padx=15, pady=10, sticky="ew")

tk.Label(frame_add_transaction, text="اسم المستلم", bg="#F5F5F5", font=("Arial", 22), fg="#000000").grid(row=0, column=4, padx=15, pady=10, sticky="w")
entry_receiver = tk.Entry(frame_add_transaction, font=("Arial", 22), bg="#FFFFFF", fg="#000000", relief="flat", bd=1, highlightthickness=1, highlightbackground="#D4A017")
entry_receiver.grid(row=0, column=5, padx=15, pady=10, sticky="ew")

add_transaction_button = ttk.Button(frame_add_transaction, text="إضافة 📋", style="TButton", command=lambda: add_transaction(
    trans_item_dropdown.get(), entry_used.get(), entry_receiver.get()
))
add_transaction_button.grid(row=0, column=6, padx=15, pady=10)

frame_add_transaction.grid_columnconfigure(1, weight=1)
frame_add_transaction.grid_columnconfigure(3, weight=1)
frame_add_transaction.grid_columnconfigure(5, weight=1)

# إطار الأزرار
